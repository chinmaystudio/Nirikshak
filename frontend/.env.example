# NIRIKSHAK frontend — copy to .env (local) or set as build variables in
# CI / Cloudflare Pages. All VITE_* values are bundled into the public app,
# so never put a secret here.

# Supabase project URL and publishable (anon) key — public by design;
# the data is protected by Row Level Security.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend API base URL.
VITE_API_BASE_URL=https://<backend-host>

# Cloudflare Turnstile site key (optional). Set together with the backend's
# TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=

# Two-step verification for government/contractor portals. Never set to
# "false" in a production build.
VITE_REQUIRE_MFA=true
