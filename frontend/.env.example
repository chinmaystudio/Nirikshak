# NIRIKSHAK frontend environment (copy to .env / .env.production and fill in)
# All VITE_* variables are bundled into the client build at build time.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key for the same project — public by design.
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Backend API base URL — this is the variable name the code reads
# (VITE_API_BASE_URL, not VITE_BACKEND_URL).
VITE_API_BASE_URL=https://your-backend.example.com
