# NIRIKSHAK frontend environment variables
# All values are optional — the app runs fully on demo/mock data without a backend.

# Base URL for the (future) backend API. When empty, the mock API layer in
# src/api/ serves demo data and all pages carry a "Demo data" label.
VITE_API_BASE_URL=

# Set to "true" to enable the mock API regardless of VITE_API_BASE_URL
# (useful when pointing VITE_API_BASE_URL at a partially built backend).
VITE_USE_MOCK_API=true

# Default interface language when the visitor has not chosen one: en | hi | mr
VITE_DEFAULT_LOCALE=en
