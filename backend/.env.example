# NIRIKSHAK Backend — environment variables
# Copy to `.env` for local development, or set these in the hosting
# dashboard (Render). NEVER commit a filled-in .env file.
# The backend refuses to boot if a REQUIRED variable is missing.

# --- REQUIRED -------------------------------------------------------------

# Supabase project URL (project ref: dmkhkgqyzevhxpxsrgng). REQUIRED.
SUPABASE_URL=https://dmkhkgqyzevhxpxsrgng.supabase.co

# Supabase anon (publishable) key for the project above. REQUIRED.
SUPABASE_ANON_KEY=

# Supabase service-role key for the project above. REQUIRED.
# Server-only secret — never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- OPTIONAL -------------------------------------------------------------

# Comma-separated list of frontend origins allowed by CORS, e.g.
# https://nirikshak.pages.dev,https://nirikshak.vercel.app
# Optional: in production, if this is unset/empty the backend falls back to
# the default production origins and logs a warning (it no longer crashes).
ALLOWED_ORIGINS=

# Runtime environment: development | production. Optional (defaults to
# the host's setting; render.yaml sets production).
NODE_ENV=

# Port the API listens on. Optional (default 4000).
PORT=4000

# OpenRouter API key — required only for the AI analysis feature
# (POST /api/ai/analyze/...). Without it the API still boots, but AI
# analysis requests fail with AI_ANALYSIS_UNAVAILABLE. Optional otherwise.
OPENROUTER_API_KEY=

# OpenRouter model id. Optional (default in code/render.yaml:
# nvidia/nemotron-3-super-120b-a12b:free).
OPENROUTER_MODEL=
