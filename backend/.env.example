# NIRIKSHAK backend — environment variables.
# Copy to `.env` for local development, or set them in the hosting dashboard.
# NEVER commit a filled-in .env file. The backend refuses to boot if a
# REQUIRED variable is missing.

# --- REQUIRED --------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Server-only secret. Never expose it to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- RECOMMENDED IN PRODUCTION -----------------------------------------------
NODE_ENV=production
# Comma-separated list of frontend origins allowed by CORS.
ALLOWED_ORIGINS=https://nirikshak.pages.dev
# Public URL of the frontend: used in confirmation-email links.
FRONTEND_URL=https://nirikshak.pages.dev

# Shared rate-limit counters (Upstash Redis REST). Without them limits are
# per serverless instance, i.e. not effective on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile secret. When set, registration, complaint filing and
# the citizen AI endpoints require a valid Turnstile token.
TURNSTILE_SECRET_KEY=

# Official email domains accepted for government registration (sub-domains included).
GOV_EMAIL_DOMAINS=gov.in,nic.in

# Number of reverse-proxy hops in front of the API (Vercel/Cloudflare = 1).
TRUST_PROXY_HOPS=1

# Two-step verification for government/contractor writes. Keep "true" in
# production; the database enforces the same rule (platform_settings.require_mfa).
REQUIRE_MFA=true

# --- AI (optional; without a key the AI endpoints return "unavailable") ------
OPENROUTER_API_KEY=
# Comma-separated model ids tried in order. Pick models that have
# zero-data-retention endpoints on OpenRouter.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b
OPENROUTER_VISION_MODELS=nvidia/nemotron-3.5-super-vl
# Route only to providers that neither retain nor train on prompts (keep true).
AI_REQUIRE_ZDR=true
# ":free" model ids are refused unless this is true (not recommended).
AI_ALLOW_FREE_MODELS=false
AI_TIMEOUT_MS=25000

# Local development only
PORT=4000
