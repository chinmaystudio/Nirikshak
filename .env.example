# NIRIKSHAK — environment variables summary (frontend + backend)
# This file is a reference only. Each part reads its variables from its own
# environment: the frontend from the Cloudflare Pages project settings (or
# frontend/.env.production locally), the backend from the Render dashboard
# (or backend/.env locally). See backend/.env.example for the backend copy.
# NEVER commit filled-in .env files.

# --- FRONTEND (Vite — set in Cloudflare Pages, Production + Preview) ------
# All three are REQUIRED at build time. Without the first two the app
# cannot start; without VITE_API_BASE_URL, registration / project creation /
# tender publication / AI analysis fail as "temporarily unavailable".
# Note: the variable is VITE_API_BASE_URL — there is no VITE_BACKEND_URL
# in the code.

# Supabase project URL (same project as the backend).
VITE_SUPABASE_URL=https://dmkhkgqyzevhxpxsrgng.supabase.co

# Supabase publishable (anon) key for that project.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the deployed backend API (Render service), e.g.
# https://nirikshak-backend-pgqm.onrender.com
VITE_API_BASE_URL=

# --- BACKEND (Express — set in the Render dashboard) -----------------------
# REQUIRED to boot: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY.
# See backend/.env.example for the full annotated list.

SUPABASE_URL=https://dmkhkgqyzevhxpxsrgng.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated CORS allowlist. If unset in production the
# backend falls back to the default production frontend origins with a
# warning instead of crashing.
ALLOWED_ORIGINS=https://nirikshak.pages.dev,https://nirikshak-craaftverse.pages.dev,https://nirikshak.vercel.app

NODE_ENV=production
PORT=4000

# Optional except for the AI analysis feature.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
